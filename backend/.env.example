# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Server ──────────────────────────────────────────────
APP_HOST=127.0.0.1
APP_PORT=8000
APP_ENV=development        # development | production
DATABASE_PATH=./focusforge.sqlite3

# SQLite account and session data is stored locally at DATABASE_PATH.
# For production, set APP_ENV=production and serve only behind HTTPS so cookies are Secure.

# ── Windows companion (optional, local only) ────────────
# The server proxies app-activity reads to this loopback address. Keep the
# default unless the companion is moved to another local port.
# COMPANION_URL=http://127.0.0.1:8765

# ── Future: AI Coach (optional, feature-flagged) ────────
# OPENAI_API_KEY=sk-...
# AI_COACH_ENABLED=false
